# All control queries unioned into one result set (generated by scripts/build_mod.py).
query "all_results" {
  sql = file("all_results.sql")
}

dashboard "compliance_overview" {
  title = "Koala Freight - Compliance Overview (synthetic data)"

  text {
    value = "**Synthetic demo data only.** Fictional company, generated CSVs, no real cloud accounts. Controls: CIS AWS Foundations v3.0.0 (subset), ACSC Essential Eight ML1, Koala Freight custom."
  }

  container {
    card {
      width = 2
      sql   = "with r as (${query.all_results.sql}) select 'Total controls' as label, count(distinct control) as value from r"
    }
    card {
      width = 2
      sql   = <<-EOQ
        with r as (${query.all_results.sql})
        select 'Pass % (ok / ok+alarm)' as label, round(100.0 * count(*) filter (where status = 'ok') / nullif(count(*) filter (where status in ('ok','alarm')), 0), 1) as value,
          'info' as type
        from r
      EOQ
    }
    card {
      width = 2
      sql   = "with r as (${query.all_results.sql}) select 'Alarms - CIS AWS' as label, count(*) as value, case when count(*) > 0 then 'alert' else 'ok' end as type from r where status = 'alarm' and framework = 'CIS AWS v3.0.0'"
    }
    card {
      width = 2
      sql   = "with r as (${query.all_results.sql}) select 'Alarms - Essential Eight' as label, count(*) as value, case when count(*) > 0 then 'alert' else 'ok' end as type from r where status = 'alarm' and framework = 'Essential Eight ML1'"
    }
    card {
      width = 2
      sql   = "with r as (${query.all_results.sql}) select 'Alarms - Custom' as label, count(*) as value, case when count(*) > 0 then 'alert' else 'ok' end as type from r where status = 'alarm' and framework = 'Koala Freight custom'"
    }
    card {
      width = 2
      sql   = "with r as (${query.all_results.sql}) select 'Controls with any alarm' as label, count(distinct control) as value, 'alert' as type from r where status = 'alarm'"
    }
  }

  container {
    chart {
      type  = "column"
      title = "Resource results by framework"
      width = 6
      sql   = <<-EOQ
        with r as (${query.all_results.sql})
        select framework, status, count(*) as total from r group by framework, status order by framework, status
      EOQ
      series "alarm" { color = "alert" }
      series "ok"    { color = "ok" }
      series "skip"  { color = "gray" }
    }
    chart {
      type  = "bar"
      title = "Alarms by Essential Eight strategy"
      width = 6
      sql   = <<-EOQ
        with r as (${query.all_results.sql})
        select framework_id as strategy, count(*) filter (where status = 'alarm') as alarms
        from r where framework = 'Essential Eight ML1' group by framework_id order by alarms desc
      EOQ
    }
  }

  table {
    title = "Failing resources"
    sql   = <<-EOQ
      with r as (${query.all_results.sql})
      select framework, framework_id as "Framework ID", control, resource, reason, scope, region
      from r where status = 'alarm' order by framework, control, resource
    EOQ
  }
}
